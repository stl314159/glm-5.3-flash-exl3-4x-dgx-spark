# Selected native1024 H16 attention-slice recipe. Copy to cluster.env and replace every
# placeholder before launch. This file is sourced by bash; keep shell quoting.
TAG=attention64h16-8f29c6d
RANK_USER=YOUR_USER
HEAD_IP=10.0.0.1
RANK_IPS=(10.0.0.1 10.0.0.2 10.0.0.3 10.0.0.4)
# Primary RoCE interface/HCA for bootstrap. The selected configuration also
# validates the secondary HCA through NCCL_IB_HCA and NCCL_IB_ADDR_RANGE below.
NETDEV=YOUR_PRIMARY_ROCE_NETDEV
HCA=YOUR_PRIMARY_ROCE_HCA
RANK_DK=("docker" "docker" "docker" "docker")
# Use available local image IDs or immutable registry references. The recorded
# qualification IDs in REQUIREMENTS.md are not downloadable registry digests.
# One image on every rank, built by recipe/build-image.sh from a MiaAI runtime root at
# 8f29c6d (2026-09-16 main). Any root at or after f906ee9 carries the per-group retention
# overlay that VLLM_PREFIX_CACHE_RETENTION_INTERVAL_SWA needs; older images ignore it.
RANK_IMG=(glm53-exl3-8f29c6d:local glm53-exl3-8f29c6d:local glm53-exl3-8f29c6d:local glm53-exl3-8f29c6d:local)

# A checked-out upstream runtime root at the pinned commit. It must contain
# overlay/ patches and files/chat_template.jinja required by node-launch.sh.
# Runtime root: a worktree of the MiaAI repo at the same commit as the image, with this
# recipe's chat template installed in files/ (build-image.sh does both).
ROOT="${HOME}/glm53-8f29c6d"
HF="${HOME}/.cache/huggingface"
VC="${HOME}/.cache/vllm-glm53-tp4-8f29c6d"
PORT=8890
RDV=29531
SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=15"

# Pinned selected configuration. Do not enable it against an image whose
# sparse MLA backend does not match recipe/patch_sparse_mla_slice.py.
SPEC_METHOD=dflash
DRAFT_TP=4
MAX_MODEL_LEN=1000000
GPU_MEM_UTIL=0.75
MAX_NUM_SEQS=8
DFLASH_TOKENS=3
MAX_NUM_BATCHED_TOKENS=2048
KV_CACHE_DTYPE=fp8
MIXED_PREFILL_CHUNK=off
# E2 fat-expert prefill kernel off by default: no measured gain on a 4x Spark fleet, and it was suspected in
# hour-long decode slowdowns (MiaAI issue #143) before the real cause was found. 1 re-enables it.
EXL3_FAT_KERNEL=0
SWAPPINESS=60
EXTRA_ARGS="--enforce-eager --long-prefill-token-threshold 1024"
VLLM_USE_BREAKABLE_CUDAGRAPH=0
# Required for qualified TP4/H16; unsupported for TP2. Value 0 is diagnostic only.
VLLM_SM120_SPARSE_MLA_SLICE_TOKENS=64
# Per-group prefix-cache retention for the DFlash2 drafter sliding-window group (MiaAI overlay
# patch_apc_per_group_retention, present in runtime roots >= f906ee9). The drafter otherwise hashes 33 of
# the ~38 block ids a cached 3584-token segment costs, for a group that never contributes to a hit; with
# several long-context sessions the block-id pool thrashes, every turn re-prefills and decode collapses.
# 0 = keep reachable boundaries only (recommended). Empty = inherit the global policy (dense).
VLLM_PREFIX_CACHE_RETENTION_INTERVAL_SWA=0
# Both HCA names must have a RoCEv2 IPv4 GID inside this range. Configure PFC
# and ECN consistently for the selected data/control priorities on all hosts
# and switch ports before preflight; this recipe does not configure network QoS.
NCCL_IB_HCA="=YOUR_PRIMARY_ROCE_HCA,YOUR_SECONDARY_ROCE_HCA"
NCCL_IB_ADDR_RANGE=10.0.0.0/15
NCCL_IB_TC=106
NCCL_IB_FIFO_TC=192
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
RDMA_GID_MODE=auto
MAINT="${HOME}/tp4-attention64h16-8f29c6d-maintenance"
